# Flask Configuration
FLASK_DEBUG=false
FLASK_ENV=production

# Admin Authentication (dang nhap trang quan tri /fct-1503)
ADMIN_USERNAME=fctvt
ADMIN_PASSWORD=1503

# Database - Neon PostgreSQL Connection (Free Forever)
# Tao tai: https://neon.tech -> Create Project -> Copy Connection String
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Render Deployment
RENDER=true

# Gemini API (Google AI) / Groq API
GROQ_API_KEY=your_groq_api_key

# Cloudflare R2 Storage (10GB Free Storage)
CLOUDFLARE_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=labor-docs-bucket
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev


# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
